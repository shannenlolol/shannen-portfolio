{
  "redirects": [
    {
      "source": "/experience",
      "destination": "/experiences",
      "permanent": true
    },
    {
      "source": "/experience/:slug",
      "destination": "/experiences/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/experiences",
      "destination": "/index.html"
    },
    {
      "source": "/experiences/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/skills",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/education",
      "destination": "/index.html"
    },
    {
      "source": "/projects",
      "destination": "/index.html"
    },
    {
      "source": "/projects/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/resume",
      "destination": "/index.html"
    }
  ]
}
