{
  "rewrites": [
    {
      "source": "/experiences",
      "destination": "/index.html"
    },
    {
      "source": "/experiences/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/skills",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/education",
      "destination": "/index.html"
    },
    {
      "source": "/projects",
      "destination": "/index.html"
    },
    {
      "source": "/projects/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/resume",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(images|display)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
